
# dulce-de-leche — data files (do not commit)
.ddl/**/*.db
.ddl/**/store/
.ddl/install-log.json
.ddl/doctor-cache.json
.ddl/compatibility-cache.json

# tool data dirs (managed by `ddl init --gates`)
.testaruda/
.pretender/
# turu private zone — machine-specific knowledge, never pushed (git history is forever)
.whisper/private/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# espectacular runtime state (lint caches), not shared
.espectacular/state/

# Build artifacts — must be repo-ignored, not dev-global-ignored: the CI
# runners have no global gitignore, and the post-build pretender gate in
# `just ci` scans unignored trees (generated build-script output trips
# file_lines; beads catherine-z91, first v0.1.0 release run).
/target

# mdBook build output (docs.yml / just docs deploy from here, never commit)
/book/

# Generated book pages (docs.yml / just docs regenerate from
# openspec/specs + workspace metadata — see docs/SUMMARY.md)
docs/generated/
