    "lhs": [
     "realize",
     "abstract"
    ],
    "rhs": [
     "spec_round"
    ],
    "rationale": "adjunction triangle 1 (unit image): abstract after realize is the spec-side round trip; catherine has no identity arrows, so the law is stated as the round trip equaling its declared composite",
    "status": "accepted"
   },
   {
    "lhs": [
     "abstract",
     "realize"
    ],
    "rhs": [
     "impl_round"
    ],
    "rationale": "adjunction triangle 2 (counit image): realize after abstract is the implementation-side round trip",
    "status": "accepted"
   },
   {
    "lhs": [
     "spec_round",
     "spec_core"
    ],
    "rhs": [
     "spec_core"
    ],
    "rationale": "the spec round trip preserves the spec's core (its intent/constraints): whatever survives realize+abstract must carry the core; a break is a spec-implementation drift witness",
    "status": "accepted"
   },
   {
    "lhs": [
     "impl_round",
     "impl_core"
    ],
    "rhs": [
     "impl_core"
    ],
    "rationale": "the implementation round trip preserves the implementation's core (its behavior): a break is the same drift seen from the implementation side",
    "status": "accepted"
   },
   {
    "lhs": [
     "witness",
     "exercise"
    ],
    "rhs": [
     "impl_t_round"
    ],
    "rationale": "adjunction triangle 1 for impl<->tests: exercise after witness is the implementation round trip through its test suite",
    "status": "accepted"
   },
   {
    "lhs": [
     "exercise",
     "witness"
    ],
    "rhs": [
     "test_round"
    ],
    "rationale": "adjunction triangle 2 for impl<->tests: witness after exercise is the suite round trip",
    "status": "accepted"
   },
   {
    "lhs": [
     "impl_t_round",
     "impl_core"
    ],
    "rhs": [
     "impl_core"
    ],
    "rationale": "the test round trip preserves the implementation's core (behavior): a break is the suite no longer witnessing the module's core \u2014 test drift",
    "status": "accepted"
   },
   {
    "lhs": [
     "test_round",
     "test_core"
    ],
    "rhs": [
     "test_core"
    ],
    "rationale": "the suite round trip preserves the suite's core (what it verifies)",
    "status": "accepted"
   },
   {
    "lhs": [
     "realize",
     "witness"
    ],
    "rhs": [
     "spec_suite"
    ],
    "rationale": "spec x tests coherence: the spec's witnessing suite is the suite of its realizing module (the correspondence triangle Spec->Impl->Suite vs the direct Spec->Suite)",
    "status": "accepted"
   },
   {
    "lhs": [
     "exercise",
     "abstract"
    ],
    "rhs": [
     "suite_spec"
    ],
    "rationale": "spec x tests coherence: the spec a suite exercises is the spec of the module it exercises (Suite->Impl->Spec)",
    "status": "accepted"
   }
  ]
 },
