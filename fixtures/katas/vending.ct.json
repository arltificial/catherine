      },
      {
        "name": "dexpect",
        "src": "Drop",
        "tgt": "Occ"
      }
    ],
    "equations": [
      {
        "lhs": [
          "hat",
          "srow"
        ],
        "rhs": [
          "hx"
        ],
        "rationale": "selection bounds: the selection head's slot row and its decoded row coordinate must agree (the axis cross-check that catches an out-of-bounds or swapped decode structurally)",
        "status": "accepted"
      },
      {
        "lhs": [
          "hat",
          "scol"
        ],
        "rhs": [
          "hy"
        ],
        "rationale": "selection bounds: column half of the head's slot/coordinate agreement",
        "status": "accepted"
      },
      {
        "lhs": [
          "dt",
          "occ"
        ],
        "rhs": [
          "dexpect"
        ],
        "rationale": "collision: a drop may only target a slot whose occupancy state is the declared free state - the series' collision invariant as a path equation",
        "status": "accepted"
      }
    ]
  },
