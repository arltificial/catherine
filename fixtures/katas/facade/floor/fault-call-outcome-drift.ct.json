    "equations": [
      {
        "lhs": [
          "call_action",
          "action_outcome"
        ],
        "rhs": [
          "call_outcome"
        ],
        "rationale": "call transparency: a facade call observes the outcome of the subsystem action it names - the delegation must be transparent at the call boundary",
        "status": "accepted"
      },
      {
        "lhs": [
          "call_spec",
          "spec_action"
        ],
        "rhs": [
          "call_action"
        ],
        "rationale": "attribution, implementation side: an implemented call performs the action its documented call names - a facade may not silently reroute a documented subsystem call",
        "status": "accepted"
      },
      {
        "lhs": [
          "call_spec",
          "spec_facade"
        ],
        "rhs": [
          "call_facade"
        ],
        "rationale": "attribution, entry-point side: an implemented call belongs to the entry point of the documented call it realizes - a facade call may not be filed under another facade operation",
        "status": "accepted"
      },
      {
        "lhs": [
          "spec_impl",
          "call_action"
        ],
        "rhs": [
          "spec_action"
        ],
        "rationale": "completeness, action side: a documented call is realized by an implementation that performs the documented action - a documented subsystem call may not lose its implementation",
        "status": "accepted"
      },
      {
        "lhs": [
          "spec_impl",
          "call_facade"
        ],
        "rhs": [
          "spec_facade"
        ],
        "rationale": "completeness, entry-point side: a documented call is realized under the entry point it was documented for",
        "status": "accepted"
      }
    ],
    "keys": [
      {
        "object": "Call",
        "arrows": [
