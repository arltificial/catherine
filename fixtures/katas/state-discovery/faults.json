          "baseline_expected": ["sample:On/stop:target-mismatch"],
          "baseline_identified": ["cell:On/stop"],
          "probe_expected": ["cell:On/stop"],
          "unique_expected": []
        },
        {
          "fixture": "near-floor-fault-missing-exit.ct.json",
          "sample": [["Off", "start"], ["Off", "stop"], ["On", "start"], ["On", "stop"]],
          "baseline_expected": ["sample:Off/start:transition-missing"],
          "baseline_identified": ["cell:Off/start"],
          "probe_expected": ["cell:Off/start"],
          "unique_expected": []
        }
      ]
