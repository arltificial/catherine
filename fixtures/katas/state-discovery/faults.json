{
  "kata": "state-discovery",
  "comparison_rule": "an element is one declared transition-table cell, spelled cell:<State>/<Event>; the baseline identifies an element only when one of its pre-registered sample assertions fails on that cell; the probe identifies an element when a check finding's witness (dangling arrow+row, or equation+row) resolves to that cell; unique = executed probe elements minus baseline-identified elements. Hypothesized underconstraint findings are discovery questions, recorded verbatim, never counted as detections; an executed construction rejection is recorded as a probe but never counted in unique.",
  "entries": [
    {
      "id": "near-floor",
      "control": true,
      "primary_fixture": "near-floor.ct.json",
      "runs": [
        {
          "fixture": "near-floor.ct.json",
          "sample": [["Off", "start"], ["Off", "stop"], ["On", "start"], ["On", "stop"]],
          "baseline_expected": [],
          "baseline_identified": [],
          "probe_expected": [],
          "unique_expected": []
        },
        {
