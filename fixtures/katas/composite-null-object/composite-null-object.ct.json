        "lhs": ["parent", "top"],
        "rhs": ["top"],
        "rationale": "root closure: a node's parent resolves to the same composite root as the node itself; the nil row is its own parent and its own top, so the Null Object is neutral and cannot become a real mount point",
        "status": "accepted"
      },
      {
        "lhs": ["top", "top"],
        "rhs": ["top"],
        "rationale": "nil identity: the root map is idempotent and nil is a fixed point, so flattening never treats the Null Object as a leaf",
        "status": "accepted"
      }
    ]
