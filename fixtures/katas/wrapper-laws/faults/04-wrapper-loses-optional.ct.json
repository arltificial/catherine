      },
      {
        "name": "decorator_note",
        "src": "Decorator",
        "tgt": "Note"
      },
      {
        "name": "decorator_result",
        "src": "Decorator",
        "tgt": "Result"
      },
      {
        "name": "key",
        "src": "Store",
        "tgt": "Key"
      },
      {
        "name": "note",
        "src": "Store",
        "tgt": "Note"
      },
      {
        "name": "proxies",
        "src": "Proxy",
        "tgt": "Store"
      },
      {
        "name": "proxy_key",
        "src": "Proxy",
        "tgt": "Key"
      },
      {
        "name": "proxy_result",
        "src": "Proxy",
        "tgt": "Result"
      },
      {
        "name": "result",
        "src": "Store",
        "tgt": "Result"
      },
      {
        "name": "stack_of",
        "src": "Stack",
        "tgt": "Decorator"
      },
      {
        "name": "stack_result",
        "src": "Stack",
        "tgt": "Result"
      }
    ],
    "equations": [
      {
        "lhs": [
          "adapts",
          "result"
        ],
        "rhs": [
          "adapter_result"
        ],
        "rationale": "adapter delegation: the adapted call returns the wrapped store's call result - wrapper.call = target.call across the adapter boundary (ploeh Adapter: translation must not change the delegated path)",
        "status": "accepted"
      },
      {
        "lhs": [
          "adapts",
          "key"
        ],
        "rhs": [
          "adapter_key"
        ],
        "rationale": "adapter identity translation: the adapter's key is the wrapped store's key - identity survives translation, not just the payload",
        "status": "accepted"
      },
      {
        "lhs": [
          "adapts",
          "note"
        ],
        "rhs": [
          "adapter_note"
        ],
        "rationale": "adapter field translation: the translated auxiliary field is the wrapped store's field - a translation may not drop a declared field",
        "status": "accepted"
      },
      {
        "lhs": [
          "proxies",
          "result"
        ],
        "rhs": [
          "proxy_result"
        ],
        "rationale": "proxy delegation: the proxied call returns the real call result - the proxy boundary is transparent for the result path",
        "status": "accepted"
      },
      {
        "lhs": [
          "proxies",
          "key"
        ],
        "rhs": [
          "proxy_key"
        ],
        "rationale": "proxy identity preservation: the proxy reports the wrapped entity's key - a proxy may not rewire identity",
        "status": "accepted"
      },
      {
        "lhs": [
          "decorates",
          "result"
        ],
        "rhs": [
          "decorator_result"
        ],
        "rationale": "decorator transparency: a decorated call returns the underlying call result - the decorator adds behaviour, never changes the answer",
        "status": "accepted"
      },
      {
        "lhs": [
          "stack_of",
          "decorator_result"
        ],
        "rhs": [
          "stack_result"
        ],
        "rationale": "decorator stacking: the whole stack returns the outermost layer's result, and two stacks over the same store must agree - stacking order cannot change the underlying result",
        "status": "accepted"
      }
    ]
  },
