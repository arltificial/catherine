        "predicate": {
          "kind": "cmp",
          "column": "kind",
          "op": "eq",
          "value": "refund"
        },
        "action": "refund/auto_credit"
      },
      {
        "name": "payout_guard",
        "predicate": {
          "kind": "cmp",
          "column": "kind",
          "op": "eq",
          "value": "payout"
